# Copy to .env and set your local PostgreSQL password.
PSI_DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/psi
PSI_COOKIE_SECURE=false

# Only needed for the one-time python -m app.bootstrap command:
# PSI_ORG_CODE=FACTORY
# PSI_ORG_NAME=工厂
# PSI_ADMIN_USERNAME=admin
# PSI_ADMIN_PASSWORD=CHOOSE_A_PASSWORD_WITH_AT_LEAST_12_CHARACTERS
